// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Specialisation {
  id        Int        @id @default(autoincrement())
  templates Template[]
  cycles    Cycle[]
  glyphes   Glyphe[]
  bestInSlots   BestInSlot[]
}

model Template {
  id    Int             @id @default(autoincrement())
  opti1 String
  opti2 String
  spe   Specialisation? @relation(fields: [speId], references: [id])
  speId Int?
}

model Cycle {
  id        Int             @id @default(autoincrement())
  monocible String
  zone      String
  spe       Specialisation? @relation(fields: [speId], references: [id])
  speId     Int?
}

model Glyphe {
  id     Int             @id @default(autoincrement())
  majeur String
  mineur String
  spe    Specialisation? @relation(fields: [speId], references: [id])
  speId  Int?
}

model BestInSlot {
  id Int                 @id @default(autoincrement())
  tete String 
  collier String
  epaule String
  cape String
  torse String
  bracelet String
  gants String 
  ceinture String
  pantalon String
  bottes String
  anneaux1 String
  anneaux2 String
  bijoux1 String
  bijoux2 String
  arme1 String
  arme2 String
  arme3 String
  spe    Specialisation? @relation(fields: [speId], references: [id])
  speId  Int?
}