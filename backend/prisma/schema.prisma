// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Specialisation {
  id        Int       @id @default(autoincrement())
  templates  Template[]
  cycles     Cycle[]
  glyphes    Glyphe[]
}

model Template {
  id   Int   @default(autoincrement()) @id
  opti1 String
  opti2 String
  spe Specialisation? @relation(fields: [speId], references: [id])
  speId Int?
}


model Cycle {
  id   Int   @default(autoincrement()) @id
  monocible String
  zone      String
  spe Specialisation? @relation(fields: [speId], references: [id])
  speId Int?
}

model Glyphe {
   id   Int   @default(autoincrement()) @id
  majeur String
  mineur String
  spe Specialisation? @relation(fields: [speId], references: [id])
  speId Int?
}
